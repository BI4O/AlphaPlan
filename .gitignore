# Git 工作树检出目录：只是同一份历史在其它分支上的视图，不需要记录
.worktrees/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 环境变量与密钥
.env
.env.*
!.env.example

# 依赖
node_modules/

# Agent 工具的本地状态：属于机器/工具层面，不属于项目配置
.claude/
skills-lock.json

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# Foundry（src/contract）：forge 把构建缓存写在项目内的 cache/，不是 out/
cache/
broadcast/

# 日志与临时文件
*.log
tmp/

# PM 与 worker 之间的临时交接物（不是交付物，不入库）
.pm-handoff/
