# Git 工作树检出目录：只是同一份历史在其它分支上的视图，不需要记录
.worktrees/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 环境变量与密钥
# .env 是本地文件，永不入库；只有 .env.example 会被提交（`!.env.example` 例外规则）。
.env
.env.*
!.env.example

# 依赖
node_modules/

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# 日志与临时文件
*.log
tmp/

# agent 运行时产物（工作目录、会话、审计日志）
workspace/
data/
