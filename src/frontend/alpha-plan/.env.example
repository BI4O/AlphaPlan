# 复制成 .env.local 再填。这些都不是密钥，但地址/块号随部署变，所以不入库。
# BASE SEPOLIA (84532)
VAULT_ADDRESS=0x...
RPC_URL=http://127.0.0.1:8545
DEPLOY_BLOCK=0
CHAIN_ID=84532
# 浏览器端读链用的端点。留空则用 https://sepolia.base.org。
# 注意：如果指向 127.0.0.1，只有本机浏览器能用（页面给评委打开时会失败）。
NEXT_PUBLIC_RPC_URL=
# 计划文件目录（默认 ../../backend/plans）
PLANS_DIR=
