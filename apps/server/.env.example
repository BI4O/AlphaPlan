# 复制到同目录的 .env 后按需修改。
#
#   cp apps/server/.env.example apps/server/.env
#
# .env 已被 .gitignore 排除，只有本文件会入库（见 .gitignore 里的 !.env.example）。
# 完整说明见仓库根 README 的「环境变量」一节。
#
# 优先级：真实环境变量 > .env。所以 `PORT=9000 pnpm start` 会覆盖文件里的 PORT。
# 留空 = 使用默认值：把 BAW_BIN= 写成空行不会把 CLI 路径变成空字符串，配置层把 "" 当未设置。

# ── 监听 ────────────────────────────────────────────────────────────────
# 默认只听本机。端口冲突就改这里——前端开发服务器会从本文件读取 PORT 并自动代理过去，
# 所以只改这一处即可（也可以用 AGENT_ORIGIN 显式覆盖代理目标）。
HOST=127.0.0.1
PORT=8787

# ── agent ──────────────────────────────────────────────────────────────
# agent 的工作目录。必须是一个只放 agent 产物的目录：agent 能在这里写文件，
# 而写入的代码会在下次启动时执行。留空 = <仓库>/workspace。指向本仓库源码会被拒绝启动。
AGENT_CWD=

# provider/modelId，例如 openai/gpt-5、deepseek/deepseek-chat、zai/glm-5。
# 留空 = 用 pi 自己的设置。
AGENT_MODEL=

# 是否给 agent 注册 pi 的 bash 工具。
# on 会让钱包边界退化为「只剩 Binance 服务端日限额」——先读 README 的「安全模型」。
AGENT_SHELL=off

# 是否把 binance-agentic-wallet skill 也交给模型。
# 阶段 1 保持 off：路由表只会引诱模型去跑它跑不了的 baw 命令。
AGENT_INCLUDE_WALLET_SKILL=off

# 让模型写脚本批量调工具 / 按需搜索工具。工具多了之后值得开。
AGENT_CODEMODE=off
AGENT_TOOL_SEARCH=off

# 连接 mcp.json 里的 MCP server。
# ⚠️ MCP 工具不在钱包守卫的视野里：一个能执行命令的 MCP 工具就是绕开守卫去调 baw 的路。
# 只接你信任的、尽量只读的 server。详见 README 拓展指南 §3。
AGENT_MCP=off

# ── 钱包 CLI ───────────────────────────────────────────────────────────
BAW_BIN=baw
BAW_TIMEOUT_MS=30000
# 留空 = <仓库>/data/baw-audit.jsonl；设为 off 关闭审计。
BAW_AUDIT_LOG=
