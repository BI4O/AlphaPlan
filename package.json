{
  "name": "superbi4o",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "pnpm --filter @superbi4o/server start",
    "dev:web": "pnpm --filter @superbi4o/web dev",
    "build:web": "pnpm --filter @superbi4o/web build",
    "test": "pnpm --filter @superbi4o/server test",
    "selftest": "pnpm --filter @superbi4o/server selftest",
    "typecheck": "pnpm --filter @superbi4o/server typecheck && pnpm --filter @superbi4o/web typecheck"
  }
}
