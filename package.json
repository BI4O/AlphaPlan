{
  "name": "superbi4o",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "npm run start --workspace @superbi4o/server",
    "dev:web": "npm run dev --workspace @superbi4o/web",
    "build:web": "npm run build --workspace @superbi4o/web",
    "test": "npm run test --workspace @superbi4o/server",
    "selftest": "npm run selftest --workspace @superbi4o/server",
    "typecheck": "npm run typecheck --workspace @superbi4o/server"
  }
}
